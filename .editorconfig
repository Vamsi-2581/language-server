root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,toml,json,neon,xml}]
indent_style = tab
indent_size = 2

[*.{nix,yml,yaml}]
indent_style = space
indent_size = 2

[{*.lock,{vendor,.direnv}/**}]
indent_style = unset
indent_size = unset
